{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baddel",
  "version": "1.0.0",
  "identifier": "com.isltanx.baddel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "copyright": "© 2026 Sultan Al-Anzi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCM0Y5NDA4REQ0Qzc1MjgKUldRb2RVemRDSlEvaXdMekxueWErZnJDZk5vc1BTN24wU3ZtWUYvTU9nTXhpenRMUUZXRVgwRU8K",
      "endpoints": [
        "https://github.com/iSltanX/Baddel/releases/latest/download/latest.json"
      ]
    }
  }
}
