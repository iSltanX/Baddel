<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>LSUIElement</key>
  <true/>
  <!-- The languages the app speaks. Without this macOS assumes English only, and everything
       it draws on our behalf (the open panel behind "Add app…", alerts, standard menu items)
       comes up in English even on an Arabic system. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>ar</string>
    <string>en</string>
  </array>
  <key>CFBundleAllowMixedLocalizations</key>
  <true/>
</dict>
</plist>
